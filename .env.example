# Copy this to .env and fill in your values (never commit .env)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Snowflake
SNOWFLAKE_ACCOUNT=your-snowflake-account-id
SNOWFLAKE_USER=your-snowflake-user@example.com

# Zoho
ZOHO_ORG_ID=your-zoho-org-id
ZOHO_BOOKS_ORG_ID=your-zoho-org-id
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_REGION=eu

# HubSpot
HUBSPOT_TOKEN=

# Freshdesk
FRESHDESK_API_KEY=
FRESHDESK_DOMAIN=
